{
  "name": "control-calidad-qc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema de Control de Calidad — MI Technologies (ISO 9001:2015)",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "concurrently -k -n client,server -c blue,green \"pnpm run dev:client\" \"pnpm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:legacy": "cross-env PORT=3002 node server.cjs",
    "build": "pnpm run build:client && pnpm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "pm2-runtime ecosystem.config.cjs",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "typecheck": "tsc -p . --noEmit && tsc -p server/tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.554.0",
    "@aws-sdk/s3-request-presigner": "^3.554.0",
    "@tanstack/react-query": "^5.51.0",
    "bcrypt": "^6.0.0",
    "chart.js": "^4.5.1",
    "date-fns": "^2.30.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "express-session": "^1.17.3",
    "i18next": "^23.12.0",
    "mssql": "^12.7.0",
    "multer": "^2.2.0",
    "openid-client": "^5.7.0",
    "passport": "^0.7.0",
    "passport-openidconnect": "^0.1.1",
    "connect-pg-simple": "^10.0.0",
    "pg": "^8.12.0",
    "pm2": "^7.0.3",
    "puppeteer": "^25.2.1",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.0",
    "recharts": "^3.9.2",
    "wouter": "^3.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/mssql": "^12.3.0",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.0",
    "@types/passport": "^1.0.16",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/pg": "^8.11.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "js-yaml": "^4.2.0"
  }
}
